{
  "manifest": 3,
  "name": "github-link-preview",
  "version": "1.0.0",
  "minAppVersion": "0.11.0",
  "icon": "🔗",
  "description": "Cmd/Ctrl-click a GitHub pull request or issue link in a terminal to preview it in a panel beside the session: status, checks, diff size, description and latest comments. Hold Alt to open the browser instead.",
  "author": "yaam",
  "hosts": [
    "api.github.com"
  ],
  "secrets": [
    {
      "name": "GITHUB_TOKEN",
      "label": "GitHub token (optional for public repos; needed for private ones and higher rate limits)"
    }
  ],
  "permissions": [
    "ui",
    "http",
    "secrets",
    "storage"
  ],
  "contributes": {
    "panel": {
      "title": "GitHub"
    },
    "links": [
      {
        "pattern": "^https://github\\.com/[^/]+/[^/]+/(pull|issues)/\\d+",
        "open": "panel"
      }
    ],
    "commands": [
      {
        "id": "open",
        "title": "GitHub: open link preview panel",
        "open": "panel",
        "context": "session"
      }
    ]
  },
  "html": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<style>\n  :root { --bg:#0A0B0F; --panel:#0D0F14; --panel2:#12151C; --line:#23272F; --text:#E7E9F0; --mut:#8B93A1; --dim:#5B6472; --accent:#F5C451; --green:#5FD38D; --red:#F07178; --purple:#C77DFF; }\n  * { box-sizing: border-box; }\n  body { margin: 0; background: var(--bg); color: var(--text); font: 13px/1.55 'IBM Plex Sans', system-ui, sans-serif; }\n  header { display: flex; gap: 6px; padding: 10px 12px; border-bottom: 1px solid var(--line); background: var(--panel); position: sticky; top: 0; }\n  input { flex: 1; min-width: 0; background: var(--bg); border: 1px solid var(--line); border-radius: 7px; color: var(--text); padding: 6px 9px; font: 12px 'JetBrains Mono', monospace; outline: none; }\n  button { background: var(--panel2); border: 1px solid var(--line); color: var(--text); border-radius: 7px; padding: 5px 10px; font: 600 12px inherit; cursor: pointer; }\n  main { padding: 14px 16px 28px; }\n  h1 { font-size: 15px; line-height: 1.35; margin: 0 0 6px; }\n  .meta { color: var(--mut); font-size: 12px; display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: center; }\n  .pill { display: inline-flex; align-items: center; gap: 5px; padding: 2px 9px; border-radius: 99px; font-weight: 700; font-size: 11px; }\n  .open { background: rgba(95,211,141,.15); color: var(--green); }\n  .closed { background: rgba(240,113,120,.15); color: var(--red); }\n  .merged { background: rgba(199,125,255,.16); color: var(--purple); }\n  .draft { background: var(--panel2); color: var(--mut); }\n  .label { padding: 1px 8px; border-radius: 99px; font-size: 11px; border: 1px solid var(--line); }\n  .stats { display: flex; gap: 14px; margin: 12px 0; font: 12px 'JetBrains Mono', monospace; color: var(--mut); }\n  .add { color: var(--green); } .del { color: var(--red); }\n  section { margin-top: 16px; }\n  h2 { font-size: 10.5px; letter-spacing: .8px; color: var(--dim); margin: 0 0 6px; text-transform: uppercase; }\n  .body { white-space: pre-wrap; word-break: break-word; color: #C9CED8; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px; max-height: 340px; overflow: auto; }\n  .check { display: flex; gap: 8px; font-size: 12px; padding: 3px 0; }\n  .ok { color: var(--green); } .bad { color: var(--red); } .wait { color: var(--accent); }\n  .comment { border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px; margin-bottom: 8px; background: var(--panel); }\n  .comment b { font-size: 12px; } .comment small { color: var(--dim); margin-left: 6px; }\n  .comment div { white-space: pre-wrap; word-break: break-word; margin-top: 4px; color: #C9CED8; font-size: 12.5px; }\n  .empty { color: var(--mut); padding: 30px 6px; text-align: center; }\n  .err { color: var(--red); }\n  a { color: var(--accent); }\n  .recent { margin-top: 18px; } .recent button { display: block; width: 100%; text-align: left; margin-bottom: 5px; font: 12px 'JetBrains Mono', monospace; background: var(--panel); }\n</style>\n</head>\n<body>\n<header>\n  <input id=\"url\" placeholder=\"https://github.com/owner/repo/pull/123\" spellcheck=\"false\">\n  <button id=\"go\">Open</button>\n  <button id=\"refresh\" title=\"Reload\">↻</button>\n</header>\n<main id=\"out\"><div class=\"empty\">Cmd/Ctrl-click a GitHub pull request or issue link in the terminal, or paste one above.</div></main>\n<script>\n  const pend = {}\n  function yaam(method, ...args) {\n    return new Promise((res, rej) => {\n      const id = Math.random().toString(36).slice(2)\n      pend[id] = { res, rej }\n      parent.postMessage({ type: 'yaam:call', callId: id, method, args }, '*')\n    })\n  }\n  const esc = s => String(s ?? '').replace(/[&<>\"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[c]))\n  const ago = iso => { const m = (Date.now() - new Date(iso).getTime()) / 60000; return m < 60 ? Math.round(m) + 'm ago' : m < 1440 ? Math.round(m / 60) + 'h ago' : Math.round(m / 1440) + 'd ago' }\n  const out = document.getElementById('out')\n  const box = document.getElementById('url')\n  let current = null\n  let hasToken = false\n\n  function parse(url) {\n    const m = /^https:\\/\\/github\\.com\\/([^/]+)\\/([^/]+)\\/(pull|issues)\\/(\\d+)/.exec(String(url || '').trim())\n    return m ? { owner: m[1], repo: m[2], kind: m[3], num: m[4], url: m[0] } : null\n  }\n\n  async function gh(path) {\n    const headers = { Accept: 'application/vnd.github+json', 'X-GitHub-Api-Version': '2022-11-28' }\n    if (hasToken) headers.Authorization = 'Bearer {{secret:GITHUB_TOKEN}}'\n    const r = await yaam('http.request', 'GET', 'https://api.github.com' + path, { headers })\n    if (r.status === 404) throw new Error(hasToken ? 'Not found (or the token cannot see this repo)' : 'Not found. Private repo? Add a GITHUB_TOKEN in Addons → github-link-preview → Secrets.')\n    if (r.status === 403 || r.status === 429) throw new Error('GitHub rate limit hit. Add a GITHUB_TOKEN for a higher limit.')\n    if (r.status >= 400) throw new Error('GitHub answered ' + r.status)\n    return JSON.parse(r.text)\n  }\n\n  async function remember(url) {\n    try {\n      const list = (await yaam('storage.get', 'recent')) || []\n      await yaam('storage.set', 'recent', [url, ...list.filter(x => x !== url)].slice(0, 8))\n    } catch { /* storage is a convenience */ }\n  }\n\n  async function showRecent() {\n    let list = []\n    try { list = (await yaam('storage.get', 'recent')) || [] } catch {}\n    if (!list.length || current) return\n    out.innerHTML = '<div class=\"empty\">Cmd/Ctrl-click a GitHub pull request or issue link in the terminal, or paste one above.</div>'\n      + '<div class=\"recent\"><h2>Recent</h2>' + list.map(u => `<button data-u=\"${esc(u)}\">${esc(u.replace('https://github.com/', ''))}</button>`).join('') + '</div>'\n    out.querySelectorAll('[data-u]').forEach(b => b.onclick = () => load(b.dataset.u))\n  }\n\n  async function load(url) {\n    const ref = parse(url)\n    if (!ref) { out.innerHTML = '<div class=\"empty err\">Not a GitHub pull request or issue URL.</div>'; return }\n    current = ref\n    box.value = ref.url\n    out.innerHTML = '<div class=\"empty\">Loading ' + esc(ref.owner + '/' + ref.repo + '#' + ref.num) + '…</div>'\n    try {\n      const base = `/repos/${ref.owner}/${ref.repo}`\n      const isPr = ref.kind === 'pull'\n      const [item, comments] = await Promise.all([\n        gh(`${base}/${isPr ? 'pulls' : 'issues'}/${ref.num}`),\n        gh(`${base}/issues/${ref.num}/comments?per_page=100`),\n      ])\n      if (current !== ref) return\n      let checks = null\n      if (isPr && item.head?.sha) {\n        try { checks = await gh(`${base}/commits/${item.head.sha}/check-runs?per_page=50`) } catch { checks = null }\n      }\n      if (current !== ref) return\n      render(ref, item, comments, checks)\n      remember(ref.url)\n    } catch (e) {\n      if (current === ref) out.innerHTML = '<div class=\"empty err\">' + esc(e.message || e) + '</div>'\n    }\n  }\n\n  function render(ref, it, comments, checks) {\n    const isPr = ref.kind === 'pull'\n    const state = isPr && it.merged ? 'merged' : it.draft ? 'draft' : it.state\n    const labels = (it.labels || []).map(l => `<span class=\"label\" style=\"border-color:#${esc(l.color)}\">${esc(l.name)}</span>`).join('')\n    const runs = checks?.check_runs || []\n    const failed = runs.filter(c => ['failure', 'timed_out', 'cancelled', 'action_required'].includes(c.conclusion))\n    const pending = runs.filter(c => c.status !== 'completed')\n    const last = comments.slice(-5)\n    out.innerHTML = `\n      <h1>${esc(it.title)} <span style=\"color:var(--dim);font-weight:400\">#${esc(ref.num)}</span></h1>\n      <div class=\"meta\">\n        <span class=\"pill ${esc(state)}\">${esc(state)}</span>\n        <span>${esc(it.user?.login)} · ${ago(it.created_at)}</span>\n        ${isPr ? `<span class=\"mono\">${esc(it.head?.ref)} → ${esc(it.base?.ref)}</span>` : ''}\n        ${labels}\n      </div>\n      ${isPr ? `<div class=\"stats\"><span class=\"add\">+${it.additions}</span><span class=\"del\">−${it.deletions}</span><span>${it.changed_files} files</span><span>${it.commits} commits</span>${it.mergeable_state ? `<span>${esc(it.mergeable_state)}</span>` : ''}</div>` : ''}\n      ${runs.length ? `<section><h2>Checks · ${runs.length - failed.length - pending.length} passed${failed.length ? ` · ${failed.length} failed` : ''}${pending.length ? ` · ${pending.length} running` : ''}</h2>\n        ${[...failed, ...pending].slice(0, 8).map(c => `<div class=\"check\"><span class=\"${c.status !== 'completed' ? 'wait' : 'bad'}\">${c.status !== 'completed' ? '●' : '✕'}</span>${esc(c.name)}</div>`).join('') || '<div class=\"check ok\">✓ all checks passed</div>'}\n      </section>` : ''}\n      <section><h2>Description</h2><div class=\"body\">${esc(it.body || 'No description.')}</div></section>\n      <section><h2>Comments · ${comments.length}</h2>\n        ${last.length ? last.map(c => `<div class=\"comment\"><b>${esc(c.user?.login)}</b><small>${ago(c.created_at)}</small><div>${esc(c.body)}</div></div>`).join('') : '<div style=\"color:var(--mut)\">No comments.</div>'}\n      </section>\n      <p style=\"margin-top:16px\"><a href=\"#\" id=\"ext\">Open on GitHub ↗</a></p>`\n    document.getElementById('ext').onclick = e => { e.preventDefault(); yaam('flash', 'Hold Alt and Cmd/Ctrl-click the link in the terminal to open it in the browser') }\n  }\n\n  window.addEventListener('message', e => {\n    const d = e.data\n    if (!d || typeof d !== 'object') return\n    if (d.type === 'yaam:result' && pend[d.callId]) {\n      d.error ? pend[d.callId].rej(new Error(d.error)) : pend[d.callId].res(d.result)\n      delete pend[d.callId]\n    }\n    if (d.type === 'yaam:context' && d.context?.url && d.context.url !== current?.url) load(d.context.url)\n  })\n  document.getElementById('go').onclick = () => load(box.value)\n  document.getElementById('refresh').onclick = () => current && load(current.url)\n  box.onkeydown = e => { if (e.key === 'Enter') load(box.value) }\n\n  yaam('secrets.list').then(list => { hasToken = list.some(s => s.name === 'GITHUB_TOKEN' && s.set) }).catch(() => {})\n    .finally(() => { parent.postMessage({ type: 'yaam:getContext' }, '*'); setTimeout(showRecent, 300) })\n</script>\n</body>\n</html>\n"
}
